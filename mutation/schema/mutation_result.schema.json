{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MutationResult",
  "type": "object",
  "required": [
    "mutant_id",
    "severity",
    "affected_invariants",
    "baseline_commit",
    "baseline_payload_manifest_sha256",
    "mutant_payload_manifest_sha256",
    "targeted_tests",
    "detecting_tests",
    "status",
    "killed",
    "survived",
    "integrity_ok",
    "started_utc",
    "completed_utc"
  ],
  "properties": {
    "mutant_id": {"type": "string"},
    "severity": {"type": "string"},
    "affected_invariants": {"type": "array", "items": {"type": "string"}},
    "baseline_commit": {"type": "string"},
    "baseline_payload_manifest_sha256": {"type": "string"},
    "mutant_payload_manifest_sha256": {"type": "string"},
    "patch_sha256": {"type": ["string", "null"]},
    "baseline_suite_exit_code": {"type": ["integer", "null"]},
    "targeted_tests": {"type": "array", "items": {"type": "string"}},
    "targeted_exit_code": {"type": ["integer", "null"]},
    "detecting_tests": {"type": "array", "items": {"type": "string"}},
    "detection_count": {"type": "integer", "minimum": 0},
    "independent_detection_families": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["KILLED", "SURVIVED", "INDETERMINATE", "CONTROL_PASS"]},
    "killed": {"type": "boolean"},
    "survived": {"type": "boolean"},
    "integrity_ok": {"type": "boolean"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "unexpected_changed_paths": {"type": "array", "items": {"type": "string"}},
    "survival_reason": {"type": ["string", "null"]},
    "indeterminate_reason": {"type": ["string", "null"]},
    "gap_registered": {"type": "boolean"},
    "gap_id": {"type": ["string", "null"]},
    "promotion_blocking": {"type": "boolean"},
    "started_utc": {"type": "string", "format": "date-time"},
    "completed_utc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
