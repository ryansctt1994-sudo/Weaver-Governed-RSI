{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryansctt1994-sudo/Weaver-Governed-RSI/blob/main/schemas/replication_receipt.schema.json",
  "title": "Independent replication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "replicator",
    "artifact",
    "environment",
    "result",
    "commands",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "replicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "relationship_disclosure", "public_key_fingerprint"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "organization": { "type": ["string", "null"] },
        "relationship_disclosure": { "type": "string", "minLength": 1 },
        "public_key_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "payload_manifest_sha256", "bundle_manifest_sha256"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "payload_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "fingerprint"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "python": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": { "enum": ["PASS", "FAIL", "INDETERMINATE"] },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code"],
        "properties": {
          "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "exit_code": { "type": "integer" },
          "stdout_sha256": { "$ref": "#/$defs/sha256" },
          "stderr_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "deviations": { "type": "array", "items": { "type": "string" }, "default": [] },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value_base64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "value_base64": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
