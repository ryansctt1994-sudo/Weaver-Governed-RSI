{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryansctt1994-sudo/Weaver-Governed-RSI/blob/main/schemas/proposal.schema.json",
  "title": "Weaver change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "proposer_id", "summary", "changes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "proposer_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "authority_target": { "type": ["string", "null"] },
    "requested_permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "protected_change_declared": { "type": "boolean", "default": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
