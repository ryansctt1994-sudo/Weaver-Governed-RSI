{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WGRSI-RC3 insight record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "generation",
    "text_sha256",
    "source_failure_sha256",
    "generator_sha256",
    "parent_insight_sha256s",
    "status"
  ],
  "properties": {
    "insight_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 0 },
    "text_sha256": { "$ref": "#/$defs/sha256" },
    "source_failure_sha256": { "$ref": "#/$defs/sha256" },
    "generator_sha256": { "$ref": "#/$defs/sha256" },
    "parent_insight_sha256s": {
      "type": "array",
      "items": { "$ref": "#/$defs/sha256" },
      "uniqueItems": true
    },
    "status": { "enum": ["CANDIDATE", "ADMITTED", "REJECTED"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
